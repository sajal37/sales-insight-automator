# ──────────────────────────────────────────────
# Sales Insight Automator — Backend Environment
# ──────────────────────────────────────────────

# API Security
API_KEY=change-me-to-a-strong-random-secret

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# LLM Provider (gemini | groq)
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Email — Resend (primary)
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=Sales Automator <onboarding@resend.dev>

# Email — SMTP fallback (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Redis (optional — falls back to sync processing if unavailable)
REDIS_URL=redis://localhost:6379/0

# SQLite job database
DATABASE_URL=sqlite:///jobs.db

# Chart storage directory
CHART_DIR=charts

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS=100000

# Rate Limiting
RATE_LIMIT=10/minute
UPLOAD_RATE_LIMIT=10/minute
